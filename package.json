{
  "name": "michikan",
  "version": "1.0.0",
  "description": "Monorepo for michikan web app",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:root": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "check:types": "turbo run check:types",
    "check:cycles": "turbo run check:cycles",
    "prepare": "husky"
  },
  "private": true,
  "keywords": [
    "NestJS",
    "Monorepo",
    "Next.js",
    "React",
    "Node.js",
    "TypeScript"
  ],
  "author": "Amrit Borah",
  "license": "MIT",
  "packageManager": "pnpm@10.33.3",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.6",
    "eslint": "^9.7.0",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "madge": "^8.0.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  }
}
