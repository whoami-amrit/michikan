{
  "name": "@michikan/api",
  "version": "0.0.1",
  "description": "API server for michikan web app",
  "author": "Amrit Borah",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build api",
    "build:worker": "nest build worker",
    "check:types": "tsc --noEmit",
    "lint": "eslint",
    "start": "dotenv-run -- nest start api",
    "start:worker": "dotenv-run -- nest start worker",
    "dev": "dotenv-run -- nest start --watch api",
    "dev:worker": "dotenv-run -- nest start --watch worker",
    "debug": "dotenv-run -- nest start --debug --watch",
    "debug:worker": "dotenv-run -- nest start --debug --watch worker",
    "prod": "dotenv-run -- node dist/api/main",
    "prod:worker": "dotenv-run -- node dist/worker/worker.main",
    "test": "dotenv-run -- jest",
    "test:watch": "dotenv-run -- jest --watch",
    "test:cov": "dotenv-run -- jest --coverage",
    "test:debug": "dotenv-run -- node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "dotenv-run -- jest --config ./test/jest-e2e.json",
    "check:cycles": "madge --circular --extensions ts src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/client-ses": "^3.1061.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@google/genai": "^2.2.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.6",
    "google-auth-library": "^10.6.2",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3",
    "@michikan/db": "workspace:*",
    "@michikan/shared": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "cookie-parser": "^1.4.7",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
