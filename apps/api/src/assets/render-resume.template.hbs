\documentclass[11pt]{article}       % set main text size
\usepackage[letterpaper,                % set paper size to letterpaper. change to a4paper for resumes outside of North America
top=0.5in,                          % specify top page margin
bottom=0.5in,                       % specify bottom page margin
left=0.5in,                         % specify left page margin
right=0.5in]{geometry}              % specify right page margin

\usepackage{XCharter}               % set font. comment this line out if you want to use the default LaTeX font Computer Modern
\usepackage[T1]{fontenc}            % output encoding
\usepackage[utf8]{inputenc}         % input encoding
\usepackage{enumitem}               % enable lists for bullet points: itemize and \item
\usepackage[hidelinks]{hyperref}    % format hyperlinks
\usepackage{titlesec}               % enable section title customization
\raggedright                        % disable text justification
\pagestyle{empty}                   % disable page numbering

% ensure PDF output will be all-Unicode and machine-readable
\input{glyphtounicode}
\pdfgentounicode=1

% format section headings: bolding, size, white space above and below
\titleformat{\section}{\bfseries\large}{}{0pt}{}[\vspace{1pt}\titlerule\vspace{-6.5pt}]

% format bullet points: size, white space above and below, white space between bullets
\renewcommand\labelitemi{$\vcenter{\hbox{\small$\bullet$}}$}
\setlist[itemize]{itemsep=-2pt, leftmargin=12pt, topsep=7pt} %%% Test various topsep values to fix vertical spacing errors

% resume starts here
\begin{document}


{{#with personalInfo}}
% name
\centerline{\Huge {{name}} }

\vspace{5pt}

% contact information
\centerline{\href{mailto:{{email}} }{ {{email}} }{{#if portfolio}} | \href{ {{portfolio.url}} }{ {{portfolio.label}} }{{/if}}{{#if github}} | \href{ {{ github }} }{ {{ getPublicProfileUrlLabel github }} }{{/if}}{{#if linkedin}} | \href{ {{linkedin }} }{ {{ getPublicProfileUrlLabel linkedin }} }{{/if}}{{#if phone}} | {{ phone }}{{/if}} }
{{/with}}

\vspace{-10pt}

{{#if summary}}
% summary section
\section*{Summary}
{{{summary}}}
\vspace{-18.5pt}
{{/if}}


% skills section
\section*{Skills}
{{#each skills}}
\textbf{ {{@key}} }: {{commaJoin this}} \\
{{/each}}

\vspace{-18.5pt}

% experience section
\section*{Experience}
{{#each experience}}
\textbf{ {{this.title}}, } { {{this.company}} } -- {{ this.location }} \hfill {{formatDate this.startDate }} -- {{#if this.endDate}}{{formatDate this.endDate }}{{else}}Present{{/if}} \\
\vspace{-9pt}
\begin{itemize}
  {{#each this.highlights}}
  \item {{this}}
  {{/each}}
\end{itemize}
{{/each}}

\vspace{-18.5pt}

% projects section
\section*{Projects}
{{#each projects}}
\textbf{ {{this.title}} } {{#if this.url}}\hfill \href{ {{this.url}} }{ {{this.url}} }{{/if}} \\
{{#if this.description}}
{{this.description}} \\
\vspace{-9pt}
{{/if}}
{{#if this.technologies}}
\textbf{Technologies:} {{commaJoin this.technologies}} \\
{{/if}}
\begin{itemize}
  {{#each this.highlights}}
  \item {{this}}
  {{/each}}
\end{itemize}
{{/each}}

\vspace{-18.5pt}

% education section
\section*{Education}
{{#each education}}
\textbf{ {{this.institution}} } -- {{this.degree}} in {{this.field}} \hfill {{formatDate this.graduationDate}} \\
{{/each}}

\end{document}
