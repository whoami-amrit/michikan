generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum JobApplicationStatus {
  NOT_APPLIED
  APPLIED
  NOT_SHORTLISTED
  SHORTLISTED
  INTERVIEW_ONGOING
  REJECTED
  ACCEPTED
}

enum Provider {
  GOOGLE
  GITHUB
  LOCAL
}

model Resume {
  id               Int               @id @default(autoincrement())
  name             String
  description      String?
  json             Json
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id])
  userId           Int
  resumeRenderJobs ResumeRenderJob[]
  jobApplications  JobApplication[]

  @@index([userId])
}

// NOTE: for 1 - 1 relationship simply add @unique to the foreign key field

model User {
  id                 Int               @id @default(autoincrement())
  email              String            @unique
  name               String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  resumes            Resume[] // 1 to n relationship with Resume
  accounts           Account[] // 1 to 1 relationship with Account
  sessions           Session[] // 1 to n relationship with Session
  activeResumeUserId Int?
  resumeRenderJobs   ResumeRenderJob[]
  jobApplications    JobApplication[]
  noClutter          Boolean           @default(true)
}

model Account {
  provider       Provider
  providerId     String // e.g. Google sub, GitHub id, or email for LOCAL
  hashedPassword String? // only for LOCAL provider
  emailVerified  DateTime?
  user           User      @relation(fields: [userId], references: [id])
  userId         Int
  sessions       Session[]

  // composite primary key
  @@id([provider, userId])
  // unique constraint to prevent duplicate identities
  @@unique([provider, userId])
  // external auth unique constraint to prevent
  // same google/github account from being linked to multiple users
  @@unique([provider, providerId])
}

model Session {
  id String @id

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  tokenHash String @unique // refresh token

  account         Account  @relation(fields: [accountProvider, userId], references: [provider, userId], onDelete: Cascade)
  accountProvider Provider

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  ip        String
  userAgent String
}

model ResumeRenderJob {
  id Int @id @default(autoincrement())

  resumeId Int
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     JobStatus
  sourceHash String

  storageKey String?
  error      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnalysisJob {
  id Int @id @default(autoincrement())

  jobApplicationId Int
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  status JobStatus @default(PENDING)

  error    String?
  analysis Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobApplication {
  id Int @id @default(autoincrement())

  resumeId Int?
  resume   Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  analysisJobs AnalysisJob[]

  status JobApplicationStatus @default(NOT_APPLIED)

  // unsaved will get removed after 30 days unless user wants to retain them
  saved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobDescription String

  title String?
}
