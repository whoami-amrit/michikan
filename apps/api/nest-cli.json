{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "projects": {
    "api": {
      "sourceRoot": "src",
      "compilerOptions": {
        "deleteOutDir": true,
        "tsConfigPath": "tsconfig.build.json"
      }
    },
    "worker": {
      "sourceRoot": "src",
      "entryFile": "src/worker.main.js",
      "compilerOptions": {
        "deleteOutDir": true,
        "assets": [
          {
            "include": "assets/**",
            "watchAssets": true
          }
        ],
        "tsConfigPath": "tsconfig.worker.json"
      }
    }
  }
}
