---
import { Button } from "@/components/ui/button";
import MichikanIcon from "../../assets/michikan-icon.svg";
import { Sun, Moon, SunMoon } from "lucide-react";
---

<header
  class="sticky top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur"
>
  <nav
    class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-6"
  >
    <a
      href="/"
      class="font-heading text-lg font-semibold tracking-tight flex gap-2 items-center"
    >
      <MichikanIcon class="size-6" />
      Michikan
    </a>
    <div
      class="hidden items-center gap-6 text-sm text-muted-foreground md:flex"
    >
      <a href="/#features" class="transition-colors hover:text-foreground"
        >Resume Builder</a
      >
      <a href="/#analysis" class="transition-colors hover:text-foreground"
        >Job Fit Analysis</a
      >
      <a href="/#tracking" class="transition-colors hover:text-foreground"
        >Application Tracking</a
      >
      <a href="/blog" class="transition-colors hover:text-foreground">Blog</a>
    </div>
    <div class="flex gap-2">
      <Button
        id="theme-switcher"
        variant={"ghost"}
        size={"icon"}
        className="hidden flex items-center justify-center"
      >
        <SunMoon data-value="system" />
        <Moon data-value="dark" />
        <Sun data-value="light" />
      </Button>
      <a
        target="_blank"
        referrerpolicy="no-referrer"
        href="https://github.com/whoami-amrit/michikan"
      >
        <Button variant={"outline"} className="flex gap-2">
          <svg
            class="size-4 fill-foreground"
            role="img"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><title>GitHub</title><path
              d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
            ></path></svg
          >
          Github</Button
        >
      </a>
      <a
        target="_blank"
        referrerpolicy="no-referrer"
        href="https://app.michikan.dev/signup"
      >
        <Button>Get Started</Button>
      </a>
    </div>
  </nav>
</header>

<script>
  const themes = [
    "system",
    ...(window.matchMedia("(prefers-color-scheme: dark)").matches
      ? ["light", "dark"]
      : ["dark", "light"]),
  ];
  const theme = localStorage.getItem("theme");
  const button = document.getElementById("theme-switcher")!;
  let selectedIndex = themes.findIndex((item) => item === theme);

  const getTheme = (localTheme) => {
    if (localTheme === "system") {
      return window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }

    return localTheme;
  };

  const updateButtonState = () => {
    const state = themes[selectedIndex];
    for (const element of button.children) {
      element.classList.add("hidden");
      if (element.getAttribute("data-value") === state) {
        element.classList.remove("hidden");
        document.documentElement.classList.remove("dark", "light");
        document.documentElement.classList.add(getTheme(state));
        localStorage.setItem("theme", state);
      }
    }
  };

  updateButtonState();
  button.classList.remove("hidden");

  button.addEventListener("click", () => {
    selectedIndex = (selectedIndex + 1) % 3;
    updateButtonState();
  });
</script>
