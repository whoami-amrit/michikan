---
import { Badge } from "@/components/ui/badge";
import { Card, CardContent } from "@/components/ui/card";

interface Props {
  id: string;
  label: string;
  title: string;
  description: string;
  bullets: string[];
  reverse?: boolean;
}

const { id, label, title, description, bullets, reverse = false } = Astro.props;
---

<section id={id} class="mx-auto w-full max-w-6xl px-6 py-14 md:py-20">
  <div class={`grid items-center gap-8 md:grid-cols-2 ${reverse ? "md:[&>*:first-child]:order-2" : ""}`}>
    <Card className="border border-dashed border-primary/40 bg-card/60">
      <CardContent className="flex min-h-64 items-center justify-center">
        <div class="flex h-full w-full items-center justify-center rounded-lg border border-border/70 bg-muted/50 text-center text-sm text-muted-foreground">
          Placeholder image / product visual
        </div>
      </CardContent>
    </Card>

    <div class="space-y-4">
      <Badge variant="secondary">{label}</Badge>
      <h2 class="font-heading text-2xl font-semibold tracking-tight md:text-3xl">{title}</h2>
      <p class="text-muted-foreground">{description}</p>
      <ul class="space-y-2 text-sm text-muted-foreground">
        {
          bullets.map((item) => (
            <li class="rounded-md border border-border/50 bg-muted/30 px-3 py-2">{item}</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
