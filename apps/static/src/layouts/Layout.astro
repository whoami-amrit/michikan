---
import "../styles/global.css";
import { Heart, Mail } from "lucide-react";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Michikan — Build resumes, analyze fit, and track applications",
  description = "Build ATS-friendly resumes, analyze job fit instantly, and track your job search in one focused workflow.",
} = Astro.props;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      const getTheme = () => {
        let localTheme;

        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          localTheme = localStorage.getItem("theme");
        } else {
          localStorage.setItem("theme", "system");
        }

        if (localTheme === "system") {
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        return localTheme;
      };

      const theme = getTheme();
      if (theme === "dark") {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body class="h-screen flex-col flex">
    <slot />
    <footer
      class="w-full border-t bg-background py-12 text-sm text-muted-foreground"
    >
      <div
        class="max-w-6xl mx-auto flex flex-col items-center sm:items-start justify-between gap-4 px-6 sm:flex-row"
      >
        <div class="flex flex-col gap-2 items-center sm:items-start">
          <p class="flex items-center gap-1.5 font-medium text-foreground">
            Built with{" "}
            <Heart
              className="size-4 fill-red-500 text-red-500 animate-pulse"
            />{" "}
            and care by{" "}
            <span
              class="font-semibold underline underline-offset-4 decoration-primary/30"
            >
              Amrit
            </span>
          </p>
          <p class="text-xs">
            @Copyright (c) {year} Amrit. All Rights Reserved.
          </p>
        </div>

        <div class="flex items-center gap-4 sm:gap-6">
          <a
            href="https://github.com/whoami-amrit"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub Profile"
            class="flex items-center gap-2 transition-colors hover:text-accent-foreground hover:fill-foreground fill-muted-foreground"
          >
            <svg
              class="size-4"
              role="img"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
              ><title>GitHub</title><path
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              ></path></svg
            >
            <span class="hidden sm:inline">GitHub</span>
          </a>

          <a
            href="mailto:amrit.kashyap@proton.me"
            aria-label="Send Email"
            class="flex items-center gap-2 transition-colors hover:text-accent-foreground"
          >
            <Mail className="size-4" />
            <span class="hidden sm:inline">Email</span>
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
