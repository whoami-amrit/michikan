---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Michikan — Build resumes, analyze fit, and track applications",
  description = "Build ATS-friendly resumes, analyze job fit instantly, and track your job search in one focused workflow.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body class="dark">
		<slot />
	</body>
</html>
