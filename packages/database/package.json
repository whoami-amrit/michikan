{
  "name": "@michikan/db",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "description": "prisma package for michikan web app",
  "scripts": {
    "build": "tsc",
    "db:generate": "dotenv-run -- prisma generate",
    "db:migrate": "dotenv-run -- prisma migrate dev",
    "db:deploy": "dotenv-run -- prisma migrate deploy",
    "db:studio": "dotenv-run -- prisma studio",
    "prebuild": "pnpm db:generate"
  },
  "author": "Amrit Borah",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "prisma": "7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
