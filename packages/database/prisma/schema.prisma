generator client {
  provider     = "prisma-client"
  output       = "../generated/cjs"
  moduleFormat = "cjs"
}

generator esmClient {
  provider = "prisma-client"
  output   = "../generated/esm"
}

datasource db {
  provider = "postgresql"
}

enum WorkerStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum JobStatus {
  NOT_APPLIED
  APPLIED
  NOT_SHORTLISTED
  SHORTLISTED
  INTERVIEW_ONGOING
  REJECTED
  ACCEPTED
}

enum Provider {
  GOOGLE
  GITHUB
  LOCAL
}

enum WorkSetting {
  REMOTE
  HYBRID
  ONSITE
}

enum ExperienceLevel {
  JUNIOR
  MID
  SENIOR
}

enum ReportGenerationStatus {
  GENERATING
  DONE
  FAILED
}

model Resume {
  id                  Int                  @id @default(autoincrement())
  name                String
  description         String?
  json                Json
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id])
  userId              Int
  resumeRenderWorkers ResumeRenderWorker[]
  jobFitAnalyses      JobFitAnalysis[]
  jobs                Job[]

  analysisReport               String?
  analysisReportGenerateStatus ReportGenerationStatus @default(GENERATING)

  @@index([userId])
}

// NOTE: for 1 - 1 relationship simply add @unique to the foreign key field

model User {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  name              String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  resumes  Resume[] // 1 to n relationship with Resume
  accounts Account[] // 1 to 1 relationship with Account
  sessions Session[] // 1 to n relationship with Session
  resumeRenderWorkers ResumeRenderWorker[]
  jobs                Job[]
  jobFitAnalyses JobFitAnalysis[]
}

model Account {
  provider       Provider
  providerId     String // e.g. Google sub, GitHub id, or email for LOCAL
  hashedPassword String? // only for LOCAL provider
  emailVerified  DateTime?
  user           User      @relation(fields: [userId], references: [id])
  userId         Int
  sessions       Session[]

  // composite primary key
  @@id([provider, userId])
  // unique constraint to prevent duplicate identities
  @@unique([provider, userId])
  // external auth unique constraint to prevent
  // same google/github account from being linked to multiple users
  @@unique([provider, providerId])
}

model Session {
  id String @id

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  tokenHash String @unique // refresh token

  account         Account  @relation(fields: [accountProvider, userId], references: [provider, userId], onDelete: Cascade)
  accountProvider Provider

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  ip        String
  userAgent String
}

model ResumeRenderWorker {
  id Int @id @default(autoincrement())

  resumeId Int
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     WorkerStatus @default(IN_PROGRESS)
  sourceHash String

  storageKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobFitAnalysis {
  id Int @id @default(autoincrement())

  title String?

  jobDescription String?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumeId Int
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  jobId Int?
  job   Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  status WorkerStatus @default(IN_PROGRESS)
  report Json?
  text   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobDescription String
  company        String
  role           String
  status         JobStatus @default(NOT_APPLIED)
  applyLink      String?
  source         String

  // Notes or Interview logs of the job
  notes String?

  jobFitAnalyses JobFitAnalysis[]

  submittedResumeId Int?
  submittedResume   Resume? @relation(fields: [submittedResumeId], references: [id], onDelete: SetNull)

  atAGlance               String?
  atAGlanceGenerateStatus ReportGenerationStatus @default(GENERATING)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dateApplied DateTime?
}
