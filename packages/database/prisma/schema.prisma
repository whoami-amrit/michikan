generator client {
  provider     = "prisma-client"
  output       = "../generated/cjs"
  moduleFormat = "cjs"
}

generator esmClient {
  provider = "prisma-client"
  output   = "../generated/esm"
}

datasource db {
  provider = "postgresql"
}

enum WorkerStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum Plan {
  FREE
  PRO
}

enum AiRunKind {
  RESUME_ANALYSIS
}

enum AiRunStatus {
  RESERVED
  SUCCEEDED
  FAILED
}

enum JobStatus {
  NOT_APPLIED
  APPLIED
  SHORTLISTED
  INTERVIEW_ONGOING
  REJECTED
  ACCEPTED
}

enum Provider {
  GOOGLE
  GITHUB
  LOCAL
}

enum WorkSetting {
  REMOTE
  HYBRID
  ONSITE
}

enum ExperienceLevel {
  JUNIOR
  MID
  SENIOR
}

enum ResumeAnalysisStatus {
  IDLE
  QUEUED
  GENERATING
  DONE
  FAILED
}

enum ResumeAnalysisError {
  QUOTA_EXCEEDED
  PROVIDER_UNAVAILABLE
  INTERNAL
}

model Resume {
  id                  Int                  @id @default(autoincrement())
  name                String
  description         String?
  json                Json
  jsonUpdatedAt       DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id])
  userId              Int
  resumeRenderWorkers ResumeRenderWorker[]
  jobs                Job[]

  analysisReport  Json?
  analysisStatus  ResumeAnalysisStatus @default(IDLE)
  analysisError   ResumeAnalysisError?
  analysisAiRunId Int?
  aiRuns          AiRun[]

  @@index([userId])
}

// NOTE: for 1 - 1 relationship simply add @unique to the foreign key field

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes             Resume[] // 1 to n relationship with Resume
  accounts            Account[] // 1 to 1 relationship with Account
  sessions            Session[] // 1 to n relationship with Session
  resumeRenderWorkers ResumeRenderWorker[]
  jobs                Job[]

  plan          Plan      @default(FREE)
  planExpiresAt DateTime?
  aiRuns        AiRun[]

  autoAnalyseResume Boolean @default(false)

  verifyOtps VerifyOtp?
}

model AiRun {
  id               Int         @id @default(autoincrement())
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           Int
  resume           Resume?     @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  resumeId         Int?
  kind             AiRunKind
  status           AiRunStatus @default(RESERVED)
  generationId     String?
  promptTokens     Int?
  cachedTokens     Int?
  completionTokens Int?
  cost             Decimal?    @db.Decimal(12, 8)
  createdAt        DateTime    @default(now())
  settledAt        DateTime?

  @@index([userId, createdAt])
  @@index([resumeId, status])
}

model VerifyOtp {
  otpHash String
  user    User   @relation(fields: [userId], references: [id])
  userId  Int    @id

  expiresAt      DateTime
  attempts       Int       @default(0)
  firstAttemptAt DateTime?

  createdAt DateTime @default(now())
}

model Account {
  provider       Provider
  providerId     String // e.g. Google sub, GitHub id, or email for LOCAL
  hashedPassword String? // only for LOCAL provider
  emailVerified  DateTime?
  user           User      @relation(fields: [userId], references: [id])
  userId         Int
  sessions       Session[]

  // composite primary key
  @@id([provider, userId])
  // unique constraint to prevent duplicate identities
  @@unique([provider, userId])
  // external auth unique constraint to prevent
  // same google/github account from being linked to multiple users
  @@unique([provider, providerId])
}

model Session {
  id String @id

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  tokenHash String @unique // refresh token

  account         Account  @relation(fields: [accountProvider, userId], references: [provider, userId], onDelete: Cascade)
  accountProvider Provider

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  ip        String
  userAgent String
}

model ResumeRenderWorker {
  id Int @id @default(autoincrement())

  resumeId Int
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     WorkerStatus @default(IN_PROGRESS)
  sourceHash String

  storageKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobDescription String
  company        String
  role           String
  status         JobStatus @default(NOT_APPLIED)
  applyLink      String?
  source         String

  // Notes or Interview logs of the job
  notes String?

  submittedResumeId Int?
  submittedResume   Resume? @relation(fields: [submittedResumeId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dateApplied DateTime?
}
