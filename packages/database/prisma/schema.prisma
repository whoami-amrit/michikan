generator client {
  provider     = "prisma-client"
  output       = "../generated/cjs"
  moduleFormat = "cjs"
}

generator esmClient {
  provider = "prisma-client"
  output   = "../generated/esm"
}

datasource db {
  provider = "postgresql"
}

enum WorkerStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum JobStatus {
  NOT_APPLIED
  APPLIED
  NOT_SHORTLISTED
  SHORTLISTED
  INTERVIEW_ONGOING
  REJECTED
  ACCEPTED
}

enum Provider {
  GOOGLE
  GITHUB
  LOCAL
}

enum WorkSetting {
  REMOTE
  HYBRID
  ONSITE
}

enum ExperienceLevel {
  JUNIOR
  MID
  SENIOR
}

model Resume {
  id                  Int                  @id @default(autoincrement())
  name                String
  description         String?
  json                Json
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id])
  userId              Int
  resumeRenderWorkers ResumeRenderWorker[]
  analyses            Analysis[]
  jobs                Job[]

  @@index([userId])
}

// NOTE: for 1 - 1 relationship simply add @unique to the foreign key field

model User {
  id                   Int                  @id @default(autoincrement())
  email                String               @unique
  name                 String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  avatar               String?
  yearsOfExperience    String // e.g 10 Year(s) or 1 Year(s) & 11 Month(s) or 0 Year(s) & 6 Month(s)
  preferredWorkSetting WorkSetting
  salaryExpectation    String // e.g. "100k-120k USD Per Annum" or "60-80 USD Per Hour"
  resumes              Resume[] // 1 to n relationship with Resume
  accounts             Account[] // 1 to 1 relationship with Account
  sessions             Session[] // 1 to n relationship with Session
  activeResumeUserId   Int?
  resumeRenderWorkers  ResumeRenderWorker[]
  jobs                 Job[]
  noClutter            Boolean              @default(true)
  analyses             Analysis[]
}

model Account {
  provider       Provider
  providerId     String // e.g. Google sub, GitHub id, or email for LOCAL
  hashedPassword String? // only for LOCAL provider
  emailVerified  DateTime?
  user           User      @relation(fields: [userId], references: [id])
  userId         Int
  sessions       Session[]

  // composite primary key
  @@id([provider, userId])
  // unique constraint to prevent duplicate identities
  @@unique([provider, userId])
  // external auth unique constraint to prevent
  // same google/github account from being linked to multiple users
  @@unique([provider, providerId])
}

model Session {
  id String @id

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  tokenHash String @unique // refresh token

  account         Account  @relation(fields: [accountProvider, userId], references: [provider, userId], onDelete: Cascade)
  accountProvider Provider

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  ip        String
  userAgent String
}

model ResumeRenderWorker {
  id Int @id @default(autoincrement())

  resumeId Int
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     WorkerStatus
  sourceHash String

  storageKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Analysis {
  id Int @id @default(autoincrement())

  title String?

  jobDescription String?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumeId Int
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  jobId Int?
  job   Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  status WorkerStatus
  report Json?
  text   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobDescription String
  company        String
  title          String
  status         JobStatus @default(NOT_APPLIED)

  // Optional meta information that can be derived during analysis
  workSetting     WorkSetting?
  experienceLevel ExperienceLevel?
  minCompensation Int?
  maxCompensation Int?
  currency        String?
  applicationUrl  String? // Moved from meta-tracking

  // Notes or Interview logs of the job
  notes String?

  analyses Analysis[]

  submittedResumeId Int?
  submittedResume   Resume? @relation(fields: [submittedResumeId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dateApplied DateTime?
}
